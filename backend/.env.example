# Backend environment example
# Use these values in Vercel or a local .env during development

# Server
PORT=5000
NODE_ENV=production

# Allowed origins (comma-separated). Include both https and http if needed for testing.
# Set this to your frontend URL(s):
ALLOWED_ORIGINS=https://human-resource-management-system-1s.vercel.app,http://human-resource-management-system-1s.vercel.app

# Alternatively you can set CLIENT_URL to a single allowed origin:
CLIENT_URL=https://human-resource-management-system-1s.vercel.app

# Vercel-provided values (optional for clarity)
VERCEL_URL=human-resource-management-system-c5.vercel.app
VERCEL_PROJECT_PRODUCTION_URL=human-resource-management-system-c5.vercel.app
